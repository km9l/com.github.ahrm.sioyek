@@ -165,22 +176,29 @@
     cmake_parse_arguments(PARSE_ARGV 1 arg "${option_args}" "${single_args}" "${multi_args}")
     _qt_internal_validate_all_args_are_parsed(arg)
 
-    if(NOT arg_ALIAS_OF)
-        message(FATAL_ERROR "ALIAS_OF keyword not passed")
