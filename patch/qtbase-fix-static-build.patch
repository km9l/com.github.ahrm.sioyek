From a6140d84697e8076734ac2940bcb82555a16504b Mon Sep 17 00:00:00 2001
From: Cristian Le <cristian.le@qt.io>
Date: Tue, 04 Feb 2025 18:33:00 +0100
Subject: [PATCH] Allow Feature to be alias of Cache variable

Change-Id: I09b65cb038567a9f68a140e53a9e06eb15c8fc13
Reviewed-by: Alexandru Croitor <alexandru.croitor@qt.io>
---

diff --git a/cmake/QtFeature.cmake b/cmake/QtFeature.cmake
index e370618..2be8de7 100644
--- a/cmake/QtFeature.cmake
+++ b/cmake/QtFeature.cmake
@@ -130,7 +130,8 @@
 # Synopsis
 #
 #   qt_feature_alias(<alias_feature>
-#       ALIAS_OF <real_feature>
+#       {ALIAS_OF_FEATURE <real_feature> | ALIAS_OF_CACHE <cache>}
